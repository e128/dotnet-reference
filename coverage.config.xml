<Configuration>
  <CodeCoverage>
    <!--
      Coverage scope is an exclude-list.
      Omitting the Include node measures every loaded assembly that has a PDB, so a new
      project counts by default. Exclude wins over Include when a module matches both.
      Matches are case-insensitive regexes over the module path.
      Used with the coverage options on dotnet test.
    -->
    <ModulePaths>
      <Exclude>
        <ModulePath>.*Tests\.dll$</ModulePath>
      </Exclude>
    </ModulePaths>
    <!-- WebApplicationFactory runs the ASP.NET Core host in process. The coverage
         engine instruments that host only when this flag is on. Without it the Web
         assembly never appears in a report. -->
    <CollectAspDotNet>True</CollectAspDotNet>
    <!-- The minimal API endpoints are lambdas generated by top-level statements.
         Excluding CompilerGeneratedAttribute removes the whole Web assembly, so
         that attribute stays measured. GeneratedCodeAttribute still excludes the
         untestable top-level builder and host boilerplate. -->
    <Attributes>
      <Exclude>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
      </Exclude>
    </Attributes>
  </CodeCoverage>
</Configuration>
