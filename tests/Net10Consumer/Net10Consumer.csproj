<Project Sdk="Microsoft.NET.Sdk">

  <!-- Proves the published package reaches a net10.0 consumer. The CI build runs with
       ReportAnalyzer, so the analyzer report names every rule that executed. A report that
       omits E128024, or a load warning, means the packaged analyzer did not run. The source
       stays clean, so the fixture compiles under the repository's analyzer severity rules. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <E128AnalyzersVersion Condition="'$(E128AnalyzersVersion)' == ''">2.7.0</E128AnalyzersVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="E128.Analyzers" Version="$(E128AnalyzersVersion)" PrivateAssets="all" />
  </ItemGroup>

</Project>
