<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The repository config maps packages to nuget.org only, so the packed analyzer in
       ../../artifacts/nupkgs is never a candidate. This fixture clears that mapping and
       serves E128.* from the local folder first. -->
  <packageSources>
    <clear />
    <add key="local" value="../../artifacts/nupkgs" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="local">
      <package pattern="E128.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
