is_global = true

# Test-specific analyzer configuration
# Overrides root .globalconfig for test projects.
# Higher global_level wins over root (level 100).
global_level = 101

# Every rule is an error in tests, with the exceptions below. Each exception exists because
# enabling the rule contradicts a framework requirement or a written repo convention.

# CA2007, MA0004, VSTHRD111: ConfigureAwait in tests
# xUnit1030 forbids ConfigureAwait(false) in test methods, so these three rules contradict it.
# Test projects compile as ConsoleApplication but are tooling, not production app code.
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.VSTHRD111.severity = none

# CA1707, S100, RCS1046: Test names use Method_Condition_Result, not Async suffixes
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.S100.severity = none
dotnet_diagnostic.RCS1046.severity = none

# S4018: Test runner helpers take explicit type arguments that pick the analyzer under test
dotnet_diagnostic.S4018.severity = none

# E128043, MA0191: Null-forgiving operator
# A guard-clause test must pass null to a non-nullable parameter. Only `null!` compiles
# warning-free, so the two rules that ban the operator contradict that test.
dotnet_diagnostic.E128043.severity = none
dotnet_diagnostic.MA0191.severity = none

# E128062: Minimum framework version for test reference assemblies (net10.0 = 100)
e128_minimum_framework_version = 100

# E128097: Comment inside test code (this repo's own test suite uses explanatory
# comments by convention; the rule encodes a consuming repo's zero-comment policy,
# not a universal one: consuming repos configure their own severity)
dotnet_diagnostic.E128097.severity = none
