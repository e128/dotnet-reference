# ── Not Enabled ───────────────────────────────
# Each rule below stays below error because enabling it makes the build impossible to pass.
# Two causes qualify: the rule contradicts another enforced rule or a framework requirement,
# or the rule needs a file or option the repo does not have. Dislike of a rule never qualifies.

# --- Opposite polarity of an enforced rule ---
dotnet_diagnostic.ma0004.severity = none         # Use ConfigureAwait(false): opposite of "app code must not"; CA2007 is scoped to DLLs
dotnet_diagnostic.rcs1090.severity = none        # Add/remove ConfigureAwait(false): same conflict as MA0004
dotnet_diagnostic.s3216.severity = none          # ConfigureAwait(false) should be used: same conflict as MA0004
dotnet_diagnostic.vsthrd111.severity = none      # Use ConfigureAwait(bool): same conflict as MA0004
dotnet_diagnostic.ma0174.severity = none         # Record should use explicit 'class' keyword: opposite of MA0175
dotnet_diagnostic.ma0177.severity = none         # Single-line XML summary: opposite of MA0211
dotnet_diagnostic.ma0214.severity = none         # Use 'await' instead of returning the task: opposite of MA0215 and RCS1174
dotnet_diagnostic.rcs1002.severity = none        # Remove braces: opposite of IDE0011, RCS1007 and csharp_prefer_braces
dotnet_diagnostic.rcs1004.severity = none        # Remove braces from if-else: opposite of IDE0011 and RCS1126
dotnet_diagnostic.rcs1016.severity = none        # Use block or expression body: one style for every member kind, while IDE0021 to IDE0027 set it per kind
dotnet_diagnostic.rcs1231.severity = none        # Make parameter ref read-only: E128019 forbids 'in CancellationToken'
dotnet_diagnostic.ide0048.severity = none        # Add parentheses for clarity: oscillates with IDE0046
dotnet_diagnostic.rcs1123.severity = none        # Add parentheses by precedence: oscillates with IDE0046

# --- Design conflict ---
dotnet_diagnostic.ide0290.severity = none        # Use primary constructors: captured parameters are mutable, and the design order puts immutability first
dotnet_diagnostic.ide0210.severity = none        # Convert to top-level statements: destructive when format.sh applies the fix

# --- Needs a file or option the repo lacks ---
dotnet_diagnostic.s1451.severity = none          # Copyright header: needs a headerFormat option
# RS0051 to RS0058: internal API tracking needs InternalAPI.Shipped.txt and InternalAPI.Unshipped.txt.
# RS1020: needs an AnalyzerCategories.txt additional file. Both groups are off by default, so no line is needed.

# --- Maintainer decision ---
dotnet_diagnostic.cs1591.severity = none         # Missing XML comment for public member: maintainer turned it off
dotnet_diagnostic.rcs0044.severity = none        # Use carriage return and linefeed as newline: maintainer turned it off
dotnet_diagnostic.rs0017.severity = none         # Symbol removed from public API but not in Shipped file: maintainer turned it off
dotnet_diagnostic.ma0007.severity = none         # Add a comma after the last value: maintainer turned it off
dotnet_diagnostic.rs1007.severity = none         # Provide localizable arguments to diagnostic descriptor: maintainer turned it off
dotnet_diagnostic.s3990.severity = none          # Assemblies should be marked with CLSCompliant: maintainer turned it off
dotnet_diagnostic.s3992.severity = none          # Assemblies should explicitly specify COM visibility: maintainer turned it off
dotnet_diagnostic.rcs0027.severity = none        # Place new line after or before binary operator: maintainer turned it off
dotnet_diagnostic.rcs1223.severity = none        # Mark publicly visible type with DebuggerDisplay attribute: maintainer turned it off
dotnet_diagnostic.rcs1111.severity = none        # Add braces to switch section with multiple statements: opposite of RCS1031, maintainer turned it off
dotnet_diagnostic.rcs1031.severity = none        # Remove unnecessary braces: maintainer turned it off
dotnet_diagnostic.rs0016.severity = none         # Add public types and members to the declared API: maintainer turned it off
dotnet_diagnostic.rcs0055.severity = none        # Fix formatting of a binary expression chain: maintainer turned it off
dotnet_diagnostic.ma0181.severity = none         # Do not use cast: maintainer turned it off
dotnet_diagnostic.s3242.severity = none          # Use a more general parameter type: maintainer turned it off
dotnet_diagnostic.ma0003.severity = none         # Name the parameter to improve code readability: maintainer turned it off
dotnet_diagnostic.rs1015.severity = none         # Provide a non-null helpLinkUri to the diagnostic descriptor: maintainer turned it off
dotnet_diagnostic.rcs0062.severity = none        # Place new line after/before arrow token of an expression body: maintainer turned it off
dotnet_diagnostic.rs1028.severity = none         # Provide a non-null customTags to the diagnostic descriptor: maintainer turned it off
dotnet_diagnostic.rcs1141.severity = none        # Add param element to documentation comment: maintainer turned it off
dotnet_diagnostic.rcs1181.severity = none        # Convert comment to documentation comment: maintainer turned it off
dotnet_diagnostic.rcs0012.severity = none        # Add blank line between single-line declarations: maintainer turned it off
dotnet_diagnostic.s1067.severity = none          # Reduce the number of conditional operators in an expression: maintainer turned it off
dotnet_diagnostic.s3267.severity = none          # Simplify loops with LINQ: maintainer turned it off
dotnet_diagnostic.rcs0053.severity = none        # Fix formatting of a tuple: maintainer turned it off
dotnet_diagnostic.rcs0061.severity = none        # Add blank line between switch sections: maintainer turned it off
dotnet_diagnostic.s126.severity = none           # Add the missing else clause: maintainer turned it off
dotnet_diagnostic.rcs0056.severity = none        # A line is too long: maintainer turned it off
dotnet_diagnostic.ma0045.severity = none         # Use the async overload and make the method async: maintainer turned it off
dotnet_diagnostic.rcs1146.severity = none        # Use conditional access: maintainer turned it off
dotnet_diagnostic.s3358.severity = none          # Extract nested ternary into a statement: maintainer turned it off
dotnet_diagnostic.s1227.severity = none          # Remove this break statement: maintainer turned it off
dotnet_diagnostic.s1200.severity = none          # Split this class to reduce type dependencies: maintainer turned it off
dotnet_diagnostic.s4055.severity = none          # Use ResourceManager for string literals: maintainer turned it off
dotnet_diagnostic.s4017.severity = none          # Remove the nested type argument: maintainer turned it off
dotnet_diagnostic.s103.severity = none           # Split this long line: maintainer turned it off
dotnet_diagnostic.s1192.severity = none          # Define a constant for a repeated literal: maintainer turned it off
dotnet_diagnostic.rcs0054.severity = none        # Fix formatting of a call chain: maintainer turned it off
dotnet_diagnostic.ss039.severity = none          # Enum should specify a default value of 0: maintainer turned it off
dotnet_diagnostic.s1301.severity = none          # Replace a switch with a ternary: maintainer turned it off
dotnet_diagnostic.rcs0063.severity = none        # Remove unnecessary blank line: maintainer turned it off
dotnet_diagnostic.ide0066.severity = none        # Use switch expression: maintainer turned it off
dotnet_diagnostic.rcs0028.severity = none        # Place new line after/before conditional operator: maintainer turned it off
dotnet_diagnostic.rcs0013.severity = none        # Add blank line between single-line declarations of different kind: maintainer turned it off
dotnet_diagnostic.rcs0008.severity = none        # Add blank line between closing brace and next statement: maintainer turned it off
dotnet_diagnostic.rcs1056.severity = none        # Avoid usage of using alias directive: Roslynator analyzer throws ArgumentNullException (AD0001)
dotnet_diagnostic.ide0046.severity = none        # Simplify if statement to a conditional return: maintainer turned it off
dotnet_diagnostic.rcs1250.severity = none        # Use explicit or implicit object creation: maintainer turned it off
dotnet_diagnostic.ide0045.severity = none        # Simplify if statement to a conditional assignment: maintainer turned it off
dotnet_diagnostic.s3240.severity = none          # Use the ?: operator: maintainer turned it off
dotnet_diagnostic.rcs1211.severity = none        # Remove unnecessary else clause: maintainer turned it off
dotnet_diagnostic.rcs0036.severity = none        # Remove blank line between single-line declarations of the same kind: maintainer turned it off
dotnet_diagnostic.s4040.severity = none          # Prefer uppercasing to invariant lowercasing: maintainer turned it off
dotnet_diagnostic.rcs1014.severity = none        # Use explicitly typed array: contradicts RCS1124, IDE0305, and IDE0300 on array collection expressions, maintainer turned it off
dotnet_diagnostic.rcs1050.severity = none        # Add parentheses when creating new object: opposite of S3235, maintainer turned it off
dotnet_diagnostic.ma0136.severity = none         # Raw string contains an implicit end of line: repo rule requires raw string test snippets, maintainer turned it off
dotnet_diagnostic.rcs1238.severity = none        # Avoid nested ternary operators: same check as S3358, maintainer turned it off
dotnet_diagnostic.ma0071.severity = none         # Avoid using redundant else: same check as RCS1211, maintainer turned it off

# --- Destructive code fix ---
# E128107/E128108: a promoted severity lets format.sh auto-apply the delete fix and remove tests without review.
dotnet_diagnostic.E128107.severity = suggestion
dotnet_diagnostic.E128108.severity = suggestion

# ── Guardrails ───────────────────────────────
# Rules enforced at error to prevent regression.

# --- E128 (own analyzers) ---
dotnet_diagnostic.E128087.severity = error       # Static numeric field increment without Interlocked

# --- FIPS Compliance (CA53xx Security) ---
# Explicitly pinned: blanket default covers these, but FIPS-critical rules
# must survive any blanket-default change.
dotnet_diagnostic.ca5350.severity = error        # Do not use weak cryptographic algorithms (MD5, SHA1)
dotnet_diagnostic.ca5351.severity = error        # Do not use broken cryptographic algorithms (DES, RC2)
dotnet_diagnostic.ca5358.severity = error        # Do not use unsafe cipher modes (ECB)
dotnet_diagnostic.ca5364.severity = error        # Do not use deprecated security protocols (SSL3, TLS 1.0, TLS 1.1)
dotnet_diagnostic.ca5373.severity = error        # Do not use obsolete key derivation function (PasswordDeriveBytes)
dotnet_diagnostic.ca5379.severity = error        # Ensure key derivation function algorithm is sufficiently strong
dotnet_diagnostic.ca5384.severity = error        # Do not use DSA
dotnet_diagnostic.ca5385.severity = error        # Use RSA with sufficient key size (>= 2048)
dotnet_diagnostic.ca5386.severity = error        # Avoid hardcoding SecurityProtocolType value
dotnet_diagnostic.ca5387.severity = error        # Do not use weak KDF with insufficient iteration count
dotnet_diagnostic.ca5388.severity = error        # Ensure sufficient iteration count when using weak KDF
dotnet_diagnostic.ca5394.severity = error        # Do not use insecure randomness (System.Random for security)
dotnet_diagnostic.ca5397.severity = error        # Do not use deprecated SslProtocols values
dotnet_diagnostic.ca5398.severity = error        # Avoid hardcoded SslProtocols values
dotnet_diagnostic.ca5401.severity = error        # Do not use CreateEncryptor with non-default IV
dotnet_diagnostic.ca5402.severity = error        # Use CreateEncryptor with the default IV
dotnet_diagnostic.ca5403.severity = error        # Do not hard-code certificate

# --- Compiler Warnings ---
dotnet_diagnostic.syslib1045.severity = error    # Use GeneratedRegexAttribute

