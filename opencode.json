{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".claude/rules/*.md"
  ],
  "permission": {
    "edit": {
      "*": "allow",
      ".claude/settings.json": "ask"
    },
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "gh pr create*": "ask",
      "gh release create*": "ask"
    }
  }
}
