{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": ".claude/settings.json", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr create *", "effect": "ask" },
    { "action": "shell", "resource": "gh release create *", "effect": "ask" },
    { "action": "shell", "resource": "git clean -fd *", "effect": "ask" },
    { "action": "shell", "resource": "git rebase *", "effect": "ask" }
  ],
  "experimental": {
    "policies": [
      { "action": "permission", "resource": "shell:git push --force*", "effect": "deny" },
      { "action": "permission", "resource": "shell:git push -f*", "effect": "deny" },
      { "action": "permission", "resource": "shell:git reset --hard*", "effect": "deny" }
    ]
  }
}
