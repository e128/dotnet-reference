<Project>

  <!-- ============================================== -->
  <!-- Runtime Async                                  -->
  <!--                                                -->
  <!-- Application projects only. A netstandard2.0    -->
  <!-- analyzer cannot take the switch, a test host   -->
  <!-- has no need for it, and a net10.0 leg has no   -->
  <!-- runtime support for it. This group sits in     -->
  <!-- .targets so IsTestProject and IsRoslynComponent -->
  <!-- are already known: a .props group evaluates    -->
  <!-- before the project body sets them.             -->
  <!-- ============================================== -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0' and '$(IsRoslynComponent)' != 'true' and '$(IsTestProject)' != 'true' and '$(IsBenchmarkProject)' != 'true'">
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <!-- ============================================== -->
  <!-- Test Projects: Microsoft Testing Platform       -->
  <!--                                                -->
  <!-- MTP is .NET 10's recommended test runner.       -->
  <!-- Test projects are standalone executables.        -->
  <!-- Must be in .targets (not .props) so that        -->
  <!-- IsTestProject is already set by the .csproj.    -->
  <!-- ============================================== -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- ============================================== -->
  <!-- E128.Analyzers: Solution-Local Roslyn Analyzer -->
  <!--                                                -->
  <!-- Applies E128 rules to all projects except the  -->
  <!-- analyzer itself. Severity is governed by        -->
  <!-- .globalconfig (blanket error by default).       -->
  <!-- ============================================== -->
  <ItemGroup Condition="'$(IsRoslynComponent)' != 'true' and Exists('$(MSBuildThisFileDirectory)src/E128.Analyzers/E128.Analyzers.csproj')">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/E128.Analyzers/E128.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
