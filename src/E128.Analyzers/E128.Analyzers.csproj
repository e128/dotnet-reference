<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- C# 14, not `latest`. The formatter rewrites a collection initializer
         with a constructor argument into the C# 15 collection expression
         argument form, `[with(comparer), ...]`. The pinned band keeps the
         sources in a form that this repository and its reviewers share. -->
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS2007: the Roslyn 4.14.0 meta-analyzer rejects valid unshipped.md content -->
    <!-- NU5128: the package declares no dependencies, so NuGet warns that lib/netstandard2.0 has no match -->
    <!-- RSEXPERIMENTAL006: the closed-hierarchy rules read the experimental ClosedKeyword.
         The maintainer approved that suppression for the closed-keyword rules. -->
    <NoWarn>$(NoWarn);RS2007;NU5128;RSEXPERIMENTAL006</NoWarn>
    <!-- PolySharp: netstandard2.0 polyfill for nullable analysis attributes only -->
    <PolySharpIncludeGeneratedTypes>
      System.Diagnostics.CodeAnalysis.NotNullWhenAttribute;System.Diagnostics.CodeAnalysis.MaybeNullWhenAttribute
    </PolySharpIncludeGeneratedTypes>
  </PropertyGroup>

  <!-- NuGet Packaging -->
  <PropertyGroup>
    <Version>3.4.2</Version>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <PackageId>E128.Analyzers</PackageId>
    <Authors>Brent Miller</Authors>
    <Description>Roslyn analyzers enforcing opinionated .NET conventions at compile time. Code fixes for most rules, covering design (sealed-by-default, async void, sync-over-async, in-modifier safety, primary constructor fields, FileSystemInfo equality, TimeProvider, IHttpClientFactory, TimeSpan for durations, mutable collection exposure, DI registration, Task.Run async lambda, excessive inheritance, enum switch, List&lt;T&gt; as IReadOnlyList&lt;T&gt;, Dictionary&lt;K,V&gt; as IReadOnlyDictionary&lt;K,V&gt;, unused interface params, static readonly arrays as ImmutableArray, stale ReferenceAssemblies, readonly struct init, ByteSize for data-size values, ByteSize unwrap via cast), reliability (DateTime.Parse roundtrip, GeneratedRegex timeout/backtracking, hardcoded /tmp paths, Task.FromResult sync I/O, Task.WhenAll unbounded/cancellation, JsonDocument lifetime, concurrency limits, catch filter OCE, options bind init, HttpClient missing OCE catch, FileInfo.Exists TOCTOU, unprotected finally cleanup, disk write-then-read round-trip, pool capacity guard, QuerySelectorAll materialization, TextContent length guard, GetAttribute element type, CompositeDetection specificity, sync local function call), performance (MinBy/MaxBy, HttpCompletionOption, string interpolation, ToArray in foreach, FrozenSet allocation, multi-string OR-chain, static readonly frozen collections, loop complexity, SHA256.HashData, StringBuilderPool), security (FIPS-approved hash algorithms, insecure Random in crypto context), style (string.Empty, Encoding.UTF8, XML doc comments, temp path conventions, null-forgiving operator, suppression audit, pragma balance, IDE1006 naming rule fix), and testing (temp directory cleanup, stale ReferenceAssemblies, Trait category). The assemblies target netstandard2.0 and the package declares no dependencies. The package ships one build per Roslyn band, so the base rules load in a .NET 10.0 host and the union rules load in a .NET 11.0 host.</Description>
    <PackageTags>roslyn;analyzer;csharp;code-analysis;net11</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/e128/dotnet-reference</PackageProjectUrl>
    <RepositoryUrl>https://github.com/e128/dotnet-reference</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="E128.Analyzers.CodeFixers" />
    <InternalsVisibleTo Include="E128.Analyzers.Tests" />
    <InternalsVisibleTo Include="E128.Analyzers.Union" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!-- Place each assembly in its Roslyn-band folder. The SDK selects exactly one
       analyzers/dotnet/roslyn{version}/cs folder per package, so the base build
       must sit in both folders. The union assembly needs Roslyn 5.12, so it sits
       in the 5.12 folder only. -->
  <PropertyGroup>
    <CodeFixersProject>$(MSBuildThisFileDirectory)..\E128.Analyzers.CodeFixers\E128.Analyzers.CodeFixers.csproj</CodeFixersProject>
    <CodeFixersOutputPath>$(ArtifactsPath)/bin/E128.Analyzers.CodeFixers/$(Configuration.ToLowerInvariant())/E128.Analyzers.CodeFixers.dll</CodeFixersOutputPath>
    <UnionProject>$(MSBuildThisFileDirectory)..\E128.Analyzers.Union\E128.Analyzers.Union.csproj</UnionProject>
    <UnionOutputPath>$(ArtifactsPath)/bin/E128.Analyzers.Union/$(Configuration.ToLowerInvariant())/E128.Analyzers.Union.dll</UnionOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll"
          Pack="true"
          PackagePath="analyzers/dotnet/roslyn5.9/cs"
          Visible="false" />
    <None Include="$(OutputPath)\$(AssemblyName).dll"
          Pack="true"
          PackagePath="analyzers/dotnet/roslyn5.12/cs"
          Visible="false" />
    <None Include="$(CodeFixersOutputPath)"
          Pack="true"
          PackagePath="analyzers/dotnet/roslyn5.9/cs"
          Visible="false" />
    <None Include="$(CodeFixersOutputPath)"
          Pack="true"
          PackagePath="analyzers/dotnet/roslyn5.12/cs"
          Visible="false" />
    <None Include="$(UnionOutputPath)"
          Pack="true"
          PackagePath="analyzers/dotnet/roslyn5.12/cs"
          Visible="false" />
  </ItemGroup>

  <!-- pack builds this project only, so build the other two components first.
       Restore runs as its own build. NuGet imports the generated props during evaluation, so
       the build needs a fresh evaluation: a distinct global property makes MSBuild evaluate
       the project again instead of reusing the evaluation from the restore call. Without it,
       a clean checkout has no package references and the build fails with CS0518. -->
  <Target Name="BuildComponentsBeforePack" BeforeTargets="GenerateNuspec">
    <MSBuild Projects="$(CodeFixersProject)" Targets="Restore" Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="$(CodeFixersProject)" Targets="Build"
             Properties="Configuration=$(Configuration);_E128PackCodeFixersBuild=true" />
    <MSBuild Projects="$(UnionProject)" Targets="Restore" Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="$(UnionProject)" Targets="Build"
             Properties="Configuration=$(Configuration);_E128PackUnionBuild=true" />
  </Target>

  <!-- Package README -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- Compiler-host guard: fails a consumer build when the host Roslyn is older
       than the 5.9 reference the base build carries. Keep that version equal to the
       base pin in Directory.Packages.props. -->
  <ItemGroup>
    <None Include="build/E128.Analyzers.targets" Pack="true" PackagePath="build" />
  </ItemGroup>

  <!-- An empty lib folder gives NuGet a framework to list on the Supported Frameworks tab.
       The package has no runtime assembly, so the placeholder file carries no code. -->
  <ItemGroup>
    <None Include="_._" Pack="true" PackagePath="lib/netstandard2.0" Visible="false" />
  </ItemGroup>

</Project>
