<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Copy the System.Text.Json dependency set beside the analyzer DLL, so the package
         can carry it into analyzers/dotnet/cs. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS2007: the Roslyn 4.14.0 meta-analyzer rejects valid unshipped.md content -->
    <!-- RS0016/RS0017: inherited override members (Initialize, SupportedDiagnostics, etc.) are
         tracked at the type+constructor level only in PublicAPI.Shipped.txt -->
    <NoWarn>$(NoWarn);RS2007;RS0016;RS0017;NU5128</NoWarn>
    <!-- PolySharp: netstandard2.0 polyfill for nullable analysis attributes only -->
    <PolySharpIncludeGeneratedTypes>
      System.Diagnostics.CodeAnalysis.NotNullWhenAttribute;System.Diagnostics.CodeAnalysis.MaybeNullWhenAttribute
    </PolySharpIncludeGeneratedTypes>
  </PropertyGroup>

  <!-- NuGet Packaging -->
  <PropertyGroup>
    <Version>2.2.0</Version>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <PackageId>E128.Analyzers</PackageId>
    <Authors>Brent Miller</Authors>
    <Description>Roslyn analyzers enforcing opinionated .NET conventions at compile time. Code fixes for most rules, covering design (sealed-by-default, async void, sync-over-async, ConfigureAwait, in-modifier safety, primary constructor fields, FileSystemInfo equality, TimeProvider, IHttpClientFactory, TimeSpan for durations, mutable collection exposure, DI registration, Task.Run async lambda, excessive inheritance, enum switch, List&lt;T&gt; as IReadOnlyList&lt;T&gt;, Dictionary&lt;K,V&gt; as IReadOnlyDictionary&lt;K,V&gt;, unused interface params, static readonly arrays as ImmutableArray, stale ReferenceAssemblies, readonly struct init, ByteSize for data-size values, ByteSize unwrap via cast), reliability (DateTime.Parse roundtrip, GeneratedRegex timeout/backtracking, hardcoded /tmp paths, Task.FromResult sync I/O, Task.WhenAll unbounded/cancellation, JsonDocument lifetime, concurrency limits, catch filter OCE, options bind init, HttpClient missing OCE catch, FileInfo.Exists TOCTOU, unprotected finally cleanup, disk write-then-read round-trip, pool capacity guard, QuerySelectorAll materialization, TextContent length guard, GetAttribute element type, CompositeDetection specificity, sync local function call), performance (MinBy/MaxBy, HttpCompletionOption, string interpolation, ToArray in foreach, FrozenSet allocation, multi-string OR-chain, static readonly frozen collections, loop complexity, SHA256.HashData, StringBuilderPool), security (FIPS-approved hash algorithms, insecure Random in crypto context), style (string.Empty, Encoding.UTF8, XML doc comments, temp path conventions, null-forgiving operator, suppression audit, pragma balance, IDE1006 naming rule fix), and testing (temp directory cleanup, stale ReferenceAssemblies, Trait category).</Description>
    <PackageTags>roslyn;analyzer;csharp;code-analysis</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/e128/dotnet-reference</PackageProjectUrl>
    <RepositoryUrl>https://github.com/e128/dotnet-reference</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="PolySharp" PrivateAssets="all" />
    <!-- The JSON reader for appsettings.json keys. PrivateAssets keeps it out of the
         package dependency list. The DLL set is packed explicitly below. -->
    <PackageReference Include="System.Text.Json" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="E128.Analyzers.CodeFixers" />
    <InternalsVisibleTo Include="E128.Analyzers.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!-- Place the analyzer DLL and the code fixer DLL in the NuGet convention path -->
  <PropertyGroup>
    <CodeFixersProject>$(MSBuildThisFileDirectory)..\E128.Analyzers.CodeFixers\E128.Analyzers.CodeFixers.csproj</CodeFixersProject>
    <CodeFixersOutputPath>$(ArtifactsPath)/bin/E128.Analyzers.CodeFixers/$(Configuration.ToLowerInvariant())/E128.Analyzers.CodeFixers.dll</CodeFixersOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <None Include="$(CodeFixersOutputPath)"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

  <!-- The System.Text.Json closure. The compiler host provides the Roslyn assemblies,
       so those stay out of the package. Every other copied DLL rides along. -->
  <ItemGroup>
    <AnalyzerDependency Include="System.Text.Json" />
    <AnalyzerDependency Include="System.Text.Encodings.Web" />
    <AnalyzerDependency Include="System.Text.Encoding.CodePages" />
    <AnalyzerDependency Include="System.IO.Pipelines" />
    <AnalyzerDependency Include="System.Memory" />
    <AnalyzerDependency Include="System.Buffers" />
    <AnalyzerDependency Include="System.Numerics.Vectors" />
    <AnalyzerDependency Include="System.Runtime.CompilerServices.Unsafe" />
    <AnalyzerDependency Include="System.Threading.Tasks.Extensions" />
    <AnalyzerDependency Include="Microsoft.Bcl.AsyncInterfaces" />
  </ItemGroup>

  <ItemGroup>
    <None Include="@(AnalyzerDependency->'$(OutputPath)\%(Identity).dll')"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

  <!-- pack builds this project only, so build the code fixers first to produce the second DLL.
       Restore runs as its own build. NuGet imports the generated props during evaluation, so
       the build needs a fresh evaluation: a distinct global property makes MSBuild evaluate
       the project again instead of reusing the evaluation from the restore call. Without it,
       a clean checkout has no package references and the build fails with CS0518. -->
  <Target Name="BuildCodeFixersBeforePack" BeforeTargets="GenerateNuspec">
    <MSBuild Projects="$(CodeFixersProject)" Targets="Restore" Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="$(CodeFixersProject)" Targets="Build"
             Properties="Configuration=$(Configuration);_E128PackCodeFixersBuild=true" />
  </Target>

  <!-- Package README -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
