<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- C# 14, not `latest`. The formatter rewrites a collection initializer
         with a constructor argument into the C# 15 collection expression
         argument form, `[with(comparer), ...]`. The pinned band keeps the
         sources in a form that this repository and its reviewers share. -->
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS2007: the Roslyn 4.14.0 meta-analyzer rejects valid unshipped.md content -->
    <!-- NU5128: the package declares no dependencies, so NuGet warns that lib/netstandard2.0 has no match -->
    <!-- RSEXPERIMENTAL006: the union rule family reads the typed UnionDeclarationSyntax node.
         The maintainer approved that suppression for the union rule family. -->
    <NoWarn>$(NoWarn);RS2007;NU5128;RSEXPERIMENTAL006</NoWarn>
    <!-- PolySharp: netstandard2.0 polyfill for nullable analysis attributes only -->
    <PolySharpIncludeGeneratedTypes>
      System.Diagnostics.CodeAnalysis.NotNullWhenAttribute;System.Diagnostics.CodeAnalysis.MaybeNullWhenAttribute
    </PolySharpIncludeGeneratedTypes>
  </PropertyGroup>

  <!-- NuGet Packaging -->
  <PropertyGroup>
    <Version>2.10.1</Version>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <PackageId>E128.Analyzers</PackageId>
    <Authors>Brent Miller</Authors>
    <Description>Roslyn analyzers enforcing opinionated .NET conventions at compile time. Code fixes for most rules, covering design (sealed-by-default, async void, sync-over-async, in-modifier safety, primary constructor fields, FileSystemInfo equality, TimeProvider, IHttpClientFactory, TimeSpan for durations, mutable collection exposure, DI registration, Task.Run async lambda, excessive inheritance, enum switch, List&lt;T&gt; as IReadOnlyList&lt;T&gt;, Dictionary&lt;K,V&gt; as IReadOnlyDictionary&lt;K,V&gt;, unused interface params, static readonly arrays as ImmutableArray, stale ReferenceAssemblies, readonly struct init, ByteSize for data-size values, ByteSize unwrap via cast), reliability (DateTime.Parse roundtrip, GeneratedRegex timeout/backtracking, hardcoded /tmp paths, Task.FromResult sync I/O, Task.WhenAll unbounded/cancellation, JsonDocument lifetime, concurrency limits, catch filter OCE, options bind init, HttpClient missing OCE catch, FileInfo.Exists TOCTOU, unprotected finally cleanup, disk write-then-read round-trip, pool capacity guard, QuerySelectorAll materialization, TextContent length guard, GetAttribute element type, CompositeDetection specificity, sync local function call), performance (MinBy/MaxBy, HttpCompletionOption, string interpolation, ToArray in foreach, FrozenSet allocation, multi-string OR-chain, static readonly frozen collections, loop complexity, SHA256.HashData, StringBuilderPool), security (FIPS-approved hash algorithms, insecure Random in crypto context), style (string.Empty, Encoding.UTF8, XML doc comments, temp path conventions, null-forgiving operator, suppression audit, pragma balance, IDE1006 naming rule fix), and testing (temp directory cleanup, stale ReferenceAssemblies, Trait category). Both assemblies target netstandard2.0 and the package declares no dependencies, so one build loads in a .NET 11 host.</Description>
    <PackageTags>roslyn;analyzer;csharp;code-analysis;net11</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/e128/dotnet-reference</PackageProjectUrl>
    <RepositoryUrl>https://github.com/e128/dotnet-reference</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="E128.Analyzers.CodeFixers" />
    <InternalsVisibleTo Include="E128.Analyzers.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!-- Place the analyzer DLL and the code fixer DLL in the NuGet convention path -->
  <PropertyGroup>
    <CodeFixersProject>$(MSBuildThisFileDirectory)..\E128.Analyzers.CodeFixers\E128.Analyzers.CodeFixers.csproj</CodeFixersProject>
    <CodeFixersOutputPath>$(ArtifactsPath)/bin/E128.Analyzers.CodeFixers/$(Configuration.ToLowerInvariant())/E128.Analyzers.CodeFixers.dll</CodeFixersOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <None Include="$(CodeFixersOutputPath)"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

  <!-- pack builds this project only, so build the code fixers first to produce the second DLL.
       Restore runs as its own build. NuGet imports the generated props during evaluation, so
       the build needs a fresh evaluation: a distinct global property makes MSBuild evaluate
       the project again instead of reusing the evaluation from the restore call. Without it,
       a clean checkout has no package references and the build fails with CS0518. -->
  <Target Name="BuildCodeFixersBeforePack" BeforeTargets="GenerateNuspec">
    <MSBuild Projects="$(CodeFixersProject)" Targets="Restore" Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="$(CodeFixersProject)" Targets="Build"
             Properties="Configuration=$(Configuration);_E128PackCodeFixersBuild=true" />
  </Target>

  <!-- Package README -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- An empty lib folder gives NuGet a framework to list on the Supported Frameworks tab.
       The package has no runtime assembly, so the placeholder file carries no code. -->
  <ItemGroup>
    <None Include="_._" Pack="true" PackagePath="lib/netstandard2.0" Visible="false" />
  </ItemGroup>

</Project>
